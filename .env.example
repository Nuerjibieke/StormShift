# Load from the repository root: set -a; source .env; set +a
STORMSHIFT_HOST=127.0.0.1
STORMSHIFT_PORT=8080
STORMSHIFT_DATA_DIR=./data
STORMSHIFT_CACHE_DIR=./.cache
STORMSHIFT_ENABLE_LLM=off
STORMSHIFT_ENABLE_VOICE=off

# Optional local OpenAI-compatible model services. No weights are included.
STORMSHIFT_FAST_MODEL=Qwen/Qwen3-8B
STORMSHIFT_DEEP_MODEL=Qwen/Qwen3-30B-A3B
STORMSHIFT_FAST_BASE_URL=http://127.0.0.1:8101/v1
STORMSHIFT_DEEP_BASE_URL=http://127.0.0.1:8102/v1
STORMSHIFT_FAST_GPU=
STORMSHIFT_DEEP_GPU=

# Optional OpenSky account. Keep real values in an untracked .env file.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
